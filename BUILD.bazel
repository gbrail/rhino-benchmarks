load("@rules_java//java:defs.bzl", "java_library", "java_binary")
load("@rules_rhino//java:defs.bzl", "junit5_test")
load("@rules_rhino//babel:defs.bzl", "babel_preprocess", "npm_install")

npm_install(
    name = "babel_deps",
    package_json = "//bazel:package.json",
    package_lock = "//bazel:package-lock.json",
)

# Transform the original benchmark sources with Babel so Rhino can run them.
# The sources live in the JetStream submodule; strip_prefix restores the
# top-level layout the Java driver expects on the classpath.
babel_preprocess(
    name = "preprocessed_benchmarks",
    srcs = glob([
        "JetStream/SunSpider/**/*.js",
        "JetStream/Octane/**/*.js",
        "JetStream/cdjs/**/*.js",
        "JetStream/RexBench/**/*.js",
        "JetStream/ARES-6/**/*.js",
        "JetStream/SeaMonster/**/*.js",
        "JetStream/WSL/**/*.js",
        "JetStream/simple/**/*.js",
        "JetStream/bigint/**/*.js",
        "JetStream/threejs/**/*.js",
    ]),
    strip_prefix = "JetStream",
    config = "//bazel:babel.config.json",
    npm = ":babel_deps",
)

# These payloads are compressed and must not be run through Babel. They are
# copied (not transformed) to their top-level classpath locations.
genrule(
    name = "compressed_benchmarks",
    srcs = [
        "JetStream/RexBench/FlightPlanner/waypoints.js.z",
        "JetStream/SeaMonster/inspector-json-payload.js.z",
    ],
    outs = [
        "RexBench/FlightPlanner/waypoints.js.z",
        "SeaMonster/inspector-json-payload.js.z",
    ],
    cmd = "cp $(location JetStream/RexBench/FlightPlanner/waypoints.js.z) $(location RexBench/FlightPlanner/waypoints.js.z) && cp $(location JetStream/SeaMonster/inspector-json-payload.js.z) $(location SeaMonster/inspector-json-payload.js.z)",
)

java_library(
    name = "rhino-benchmarks",
    srcs = glob(["src/main/java/**/*.java"]),
    resources = glob(["src/main/resources/**"]) + [
        ":compressed_benchmarks",
        ":preprocessed_benchmarks",
    ],
    deps = [
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:info_picocli_picocli",
        "@rhino//rhino",
    ],
)

java_binary(
    name = "benchmarks",
    main_class = "org.brail.rhinobenchmarks.Main",
    jvm_flags = [
        "-XX:MaxGCPauseMillis=50",
        "-XX:-TieredCompilation",
        "-Xms4G",
        "-Xmx4G",
    ],
    runtime_deps = [
        ":rhino-benchmarks",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:info_picocli_picocli",
        "@rhino//rhino",
    ],
)

java_binary(
    name = "compare",
    main_class = "org.brail.rhinobenchmarks.Compare",
    runtime_deps = [
        ":rhino-benchmarks",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:info_picocli_picocli",
    ],
)

junit5_test(
    name = "smoke-test",
    size = "medium",
    srcs = ["src/test/java/org/brail/rhinobenchmarks/test/StandardBenchmarkTest.java"],
    # The benchmark scripts come in through the ":rhino-benchmarks" library's
    # resources (preprocessed by Babel) rather than as data dependencies.
    test_class = "org.brail.rhinobenchmarks.test.StandardBenchmarkTest",
    deps = [
        ":rhino-benchmarks",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_junit_jupiter_junit_jupiter_params",
        "@rhino//rhino",
    ],
)
